#!/bin/bash

while read -r line
do
    echo "$line"
done < <(cat /etc/motd.d/dnf5-automatic)

str="$(stat -c %y /etc/motd.d/dnf5-automatic)"
str="${str::19}"
str="Modified: $str"
echo "$str"

while read -r line
do
    echo "$line"
done < <(systemctl list-timers dnf5-a* --all)

while read -r line
do
    echo "$line"
done < <(dnf -C repoquery --unneeded)
